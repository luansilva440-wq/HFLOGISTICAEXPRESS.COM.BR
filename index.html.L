<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HF Logística Express: Entrega para o seu Marketplace</title>
<meta name="description" content="Transportadora especializada em entregas para lojistas de marketplace na Grande São Paulo. Mais de 5 anos de mercado, controle total de cada devolução, agilidade e atendimento direto.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0B1F3D;
    --navy-2:#0B3D91;
    --blue:#1E6FFF;
    --amber:#FDB813;
    --amber-dark:#C98B00;
    --ink:#0A0A0A;
    --paper:#FAFBFD;
    --paper-2:#F1F5FC;
    --line:#E3E9F5;
    --grey:#5B6472;
    --white:#FFFFFF;
    --radius:14px;
    --maxw:1160px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Manrope',system-ui,sans-serif;
    color:var(--ink);
    background:var(--paper);
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.disp{
    font-family:'Archivo Expanded',system-ui,sans-serif;
    font-weight:800;
    line-height:1.05;
    margin:0;
    letter-spacing:-0.01em;
  }
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px;}
  :focus-visible{outline:3px solid var(--blue);outline-offset:3px;}
  button{font-family:inherit;}

  /* ---------- NAVBAR ---------- */
  header.nav{
    position:sticky;top:0;z-index:50;
    background:var(--white);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{
    max-width:var(--maxw);margin:0 auto;padding:12px 24px;
    display:flex;align-items:center;justify-content:space-between;gap:16px;
  }
  .nav-logo{display:flex;align-items:center;gap:14px;text-decoration:none;}
  .nav-logo img{height:84px;width:auto;}
  .nav-slogan{font-size:13px;font-weight:600;color:var(--navy-2);border-left:1px solid var(--line);padding-left:14px;max-width:180px;line-height:1.35;}
  .foot-slogan{color:var(--amber);font-weight:600;font-size:13.5px;margin:14px 0 0;}
  .nav-cta{
    display:inline-flex;align-items:center;gap:8px;
    background:var(--navy-2);color:var(--white);
    font-weight:700;font-size:14px;
    padding:11px 20px;border-radius:999px;
    text-decoration:none;white-space:nowrap;
    transition:background .18s ease, transform .18s ease;
  }
  .nav-cta:hover{background:var(--blue);transform:translateY(-1px);}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    background:var(--navy);
    color:var(--white);
    overflow:hidden;
    padding:88px 0 120px;
  }
  .hero .wrap{position:relative;z-index:2;}
  .hero-eyebrow{
    font-weight:700;font-size:13px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--amber);margin-bottom:18px;
  }
  .hero h1{
    font-size:clamp(34px,5.4vw,58px);
    max-width:820px;
    color:var(--white);
  }
  .hero h1 em{
    font-style:normal;color:var(--amber);
  }
  .hero p.lead{
    margin-top:22px;max-width:560px;
    font-size:18px;line-height:1.55;color:#C9D6ED;
  }
  .hero-actions{margin-top:34px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;}
  .btn-primary{
    display:inline-flex;align-items:center;gap:10px;
    background:var(--amber);color:var(--navy);
    font-weight:800;font-size:16px;
    padding:16px 28px;border-radius:999px;
    text-decoration:none;
    box-shadow:0 10px 30px -8px rgba(253,184,19,.55);
    transition:transform .18s ease, box-shadow .18s ease;
  }
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 34px -6px rgba(253,184,19,.65);}
  .btn-ghost{
    display:inline-flex;align-items:center;gap:8px;
    color:#DCE6F7;font-weight:600;font-size:15px;
    text-decoration:none;border-bottom:1px solid rgba(255,255,255,.35);
    padding-bottom:2px;
  }
  .hero-stats{
    margin-top:56px;display:flex;gap:0;flex-wrap:wrap;
    border-top:1px solid rgba(255,255,255,.15);
    padding-top:28px;
  }
  .hero-stats div{padding-right:44px;}
  .hero-stats .num{font-family:'Archivo Expanded';font-weight:800;font-size:26px;color:var(--white);}
  .hero-stats .lab{font-size:12.5px;color:#9FB2D6;margin-top:4px;max-width:150px;}

  /* route motif */
  .route-svg{position:absolute;inset:0;width:100%;height:100%;z-index:1;opacity:.55;pointer-events:none;}
  .route-path{
    fill:none;stroke:#2E5CA8;stroke-width:2;stroke-dasharray:6 10;
    animation:dash 34s linear infinite;
  }
  .route-dot{fill:var(--amber);}
  @keyframes dash{ to{ stroke-dashoffset:-1000; } }
  @media (prefers-reduced-motion:reduce){ .route-path{animation:none;} }

  .hero-cut{
    position:absolute;left:0;right:0;bottom:-1px;height:64px;z-index:2;
    background:var(--paper);
    clip-path:polygon(0 100%, 100% 100%, 100% 0, 0 100%);
  }

  /* ---------- SECTION HEADS ---------- */
  .section{padding:96px 0;}
  .section.tight{padding:72px 0;}
  .eyebrow{
    font-weight:700;font-size:12.5px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--blue);margin-bottom:14px;
  }
  .section h2{font-size:clamp(26px,3.4vw,38px);color:var(--navy);max-width:640px;}
  .section p.sub{color:var(--grey);font-size:16px;max-width:560px;margin-top:14px;line-height:1.6;}

  /* ---------- PILLARS ---------- */
  .pillars{
    display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px;
  }
  .pillar{
    background:var(--white);border:1px solid var(--line);border-radius:var(--radius);
    padding:30px 26px;position:relative;
  }
  .pillar .icon{
    width:48px;height:48px;border-radius:12px;background:var(--paper-2);
    display:flex;align-items:center;justify-content:center;margin-bottom:20px;
  }
  .pillar h3{font-size:19px;color:var(--navy);margin-bottom:10px;}
  .pillar p{color:var(--grey);font-size:14.5px;line-height:1.6;margin:0;}

  /* ---------- SERVICE TIERS ---------- */
  .tiers{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:48px;}
  .tier{
    border-radius:var(--radius);padding:32px;position:relative;overflow:hidden;
  }
  .tier.same{background:var(--navy);color:var(--white);}
  .tier.next{background:var(--white);border:1px solid var(--line);}
  .tier .badge{
    display:inline-block;font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
    padding:5px 12px;border-radius:999px;margin-bottom:16px;
  }
  .tier.same .badge{background:rgba(253,184,19,.18);color:var(--amber);}
  .tier.next .badge{background:var(--paper-2);color:var(--navy-2);}
  .tier h3{font-size:22px;margin-bottom:10px;}
  .tier.next h3{color:var(--navy);}
  .tier p{font-size:14.5px;line-height:1.65;margin:0;}
  .tier.same p{color:#C9D6ED;}
  .tier.next p{color:var(--grey);}

  /* ---------- HOW IT WORKS ---------- */
  .how{background:var(--paper-2);}
  .steps{
    margin-top:52px;display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;
  }
  .steps::before{
    content:"";position:absolute;top:23px;left:6%;right:6%;height:2px;
    background:repeating-linear-gradient(to right, var(--blue) 0 10px, transparent 10px 18px);
  }
  .step{position:relative;padding-right:18px;}
  .step .n{
    width:46px;height:46px;border-radius:50%;background:var(--navy-2);color:var(--white);
    display:flex;align-items:center;justify-content:center;font-family:'Archivo Expanded';font-weight:800;
    font-size:17px;position:relative;z-index:2;margin-bottom:18px;
  }
  .step h4{font-size:15.5px;color:var(--navy);margin:0 0 8px;font-weight:800;}
  .step p{font-size:13.5px;color:var(--grey);line-height:1.55;margin:0;}

  /* ---------- CONTROL PROOF ---------- */
  .proof{
    display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center;
  }
  .proof-card{
    background:var(--navy);color:var(--white);border-radius:20px;padding:34px;
    position:relative;overflow:hidden;
  }
  .proof-card .tag{
    display:inline-block;background:rgba(253,184,19,.15);color:var(--amber);
    font-size:11.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
    padding:5px 12px;border-radius:999px;margin-bottom:16px;
  }
  .proof-row{
    display:flex;justify-content:space-between;align-items:center;
    padding:12px 0;border-bottom:1px solid rgba(255,255,255,.12);font-size:13.5px;
  }
  .proof-row:last-child{border-bottom:none;}
  .proof-row .status{
    font-weight:700;font-size:11.5px;padding:4px 10px;border-radius:999px;
  }
  .status.pendente{background:rgba(255,99,99,.18);color:#FF9C9C;}
  .status.descontado{background:rgba(70,214,140,.18);color:#7EEBAF;}
  .status.analise{background:rgba(255,196,64,.2);color:#FFCE66;}

  /* ---------- TRUST ---------- */
  .trust{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px;}
  .trust-banner{background:var(--navy);}
  .trust-banner .eyebrow{color:var(--amber);}
  .trust-banner h2{color:var(--white);}
  .trust-item{text-align:left;}
  .trust-item .num{font-family:'Archivo Expanded';font-weight:800;font-size:40px;color:var(--amber);}
  .trust-item .lab{font-size:13.5px;color:#C9D6ED;margin-top:8px;line-height:1.5;}

  /* ---------- TESTIMONIALS ---------- */
  .testi-wrap{margin-top:48px;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .testi{
    background:var(--white);border:1px solid var(--line);border-radius:var(--radius);
    padding:28px;display:flex;flex-direction:column;gap:16px;
  }
  .testi .stars{color:var(--amber);font-size:15px;letter-spacing:2px;}
  .testi p.quote{font-size:14.5px;color:var(--ink);line-height:1.65;margin:0;flex:1;}
  .testi .who{font-size:13px;color:var(--grey);font-weight:700;}
  .testi .who span{display:block;font-weight:500;color:#8892A0;font-size:12px;margin-top:2px;}
  .testi-note{
    margin-top:22px;font-size:12.5px;color:#9AA6B8;font-style:italic;
  }

  /* ---------- FAQ ---------- */
  .faq{max-width:820px;margin-top:44px;}
  .faq-item{border-bottom:1px solid var(--line);}
  .faq-q{
    width:100%;text-align:left;background:none;border:none;cursor:pointer;
    padding:20px 0;display:flex;justify-content:space-between;align-items:center;gap:16px;
    font-size:16px;font-weight:700;color:var(--navy);
  }
  .faq-q .plus{
    flex:0 0 auto;width:24px;height:24px;border-radius:50%;background:var(--paper-2);
    display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--navy-2);
    transition:transform .2s ease;
  }
  .faq-item[data-open="true"] .plus{transform:rotate(45deg);}
  .faq-a{
    max-height:0;overflow:hidden;transition:max-height .25s ease;
  }
  .faq-a p{margin:0 0 20px;color:var(--grey);font-size:14.5px;line-height:1.65;max-width:680px;}

  /* ---------- AREA ---------- */
  .area{background:var(--navy);color:var(--white);}
  .area .eyebrow{color:var(--amber);}
  .area h2{color:var(--white);}
  .area p.sub{color:#B9C8E6;}
  .chips{margin-top:40px;display:flex;flex-wrap:wrap;gap:12px;}
  .chip{
    background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);
    color:#E6EDF9;padding:10px 18px;border-radius:999px;font-size:14px;font-weight:600;
  }
  .chip.more{background:transparent;border-style:dashed;color:#9FB2D6;}
  .map-wrap{margin-top:36px;max-width:760px;}
  .area-map{width:100%;height:auto;}
  .map-label{font-size:15px;font-family:'Manrope',sans-serif;font-weight:700;fill:#E6EDF9;}
  .map-center-label{font-size:15px;font-family:'Archivo Expanded',sans-serif;font-weight:800;fill:#0B1F3D;}
  .map-center-sub{font-size:11px;font-family:'Manrope',sans-serif;font-weight:700;fill:#0B1F3D;letter-spacing:.06em;}
  .map-note{margin-top:18px;font-size:12px;color:#8FA8D6;}

  /* ---------- FINAL CTA ---------- */
  .final{
    background:var(--amber);
    padding:64px 0;
  }
  .final .wrap{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;}
  .final h2{color:var(--navy);font-size:clamp(24px,3.2vw,32px);max-width:520px;}
  .final .btn-primary{background:var(--navy);color:var(--white);box-shadow:none;}
  .final .btn-primary:hover{background:var(--ink);}

  /* ---------- FOOTER ---------- */
  footer{background:var(--ink);color:#9AA6B8;padding:44px 0 28px;}
  .foot-top{display:flex;justify-content:space-between;flex-wrap:wrap;gap:24px;align-items:center;padding-bottom:24px;border-bottom:1px solid #23262E;}
  .foot-logo{display:flex;align-items:center;gap:10px;}
  .foot-logo img{height:34px;background:#fff;border-radius:6px;padding:3px;}
  .foot-logo span{color:var(--white);font-weight:800;font-family:'Archivo Expanded';font-size:15px;}
  footer .foot-cta{color:var(--amber);text-decoration:none;font-weight:700;font-size:14px;}
  .foot-info{padding-top:22px;font-size:12.5px;line-height:1.8;display:flex;flex-wrap:wrap;gap:32px;}
  .foot-bottom{padding-top:18px;margin-top:18px;border-top:1px solid #23262E;font-size:12px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;}

  /* ---------- RESPONSIVE ---------- */
  @media (max-width:920px){
    .pillars{grid-template-columns:1fr;}
    .tiers{grid-template-columns:1fr;}
    .steps{grid-template-columns:1fr 1fr;row-gap:32px;}
    .steps::before{display:none;}
    .proof{grid-template-columns:1fr;}
    .proof-card{order:-1;}
    .trust{grid-template-columns:1fr 1fr;row-gap:28px;}
    .testi-wrap{grid-template-columns:1fr;}
  }
  @media (max-width:680px){
    .nav-slogan{display:none;}
    .nav-logo img{height:52px;}
  }
  @media (max-width:600px){
    .nav-inner{padding:10px 16px;}
    .nav-cta span.long{display:none;}
    .hero{padding:56px 0 90px;}
    .section{padding:64px 0;}
    .steps{grid-template-columns:1fr;}
    .final .wrap{flex-direction:column;align-items:flex-start;}
    .trust{grid-template-columns:1fr 1fr;}
  }
</style>
</head>
